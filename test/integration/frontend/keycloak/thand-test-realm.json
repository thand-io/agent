      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "attributes": {
        "name": [
          "Test User"
        ]
      }
    },
    {
      "username": "manager@thand.io",
      "email": "manager@thand.io",
      "firstName": "Manager",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "managerpass123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "manager"
      ],
      "attributes": {
        "name": [
          "Manager User"
        ]
      }
    },
    {
      "username": "engineer@thand.io",
      "email": "engineer@thand.io",
      "firstName": "Engineer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "attributes": {
        "name": [
          "Engineer User"
        ]
      }
    },
    {
      "username": "developer@thand.io",
      "email": "developer@thand.io",
      "firstName": "Developer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "attributes": {
        "name": [
          "Developer User"
        ]
      }
