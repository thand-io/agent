ntext, testCase *TestCase) *UITestInfrastructure {// SetupUITestInfrastructure creates and starts all containers needed for UI E2E tests}	cleanupCallbacks []func()	// Cleanup callbacks - called before container teardown to gracefully shutdown workers	configDir string	// Config directory	ThandAPIEndpoint string	ThandEndpoint    string	thandContainer   testcontainers.Container	// Thand Server	MockOIDCEndpoint  string	mockOIDCContainer testcontainers.Container	// Mock OIDC Provider	TemporalClient    client.Client	TemporalEndpoint  string	temporalContainer testcontainers.Container	// Temporal	postgresContainer testcontainers.Container	// PostgreSQL (for Temporal)	MailHogAPI       string // HTTP API endpoint for reading emails	MailHogSMTP      string // SMTP endpoint for sending (host:port)	mailhogContainer testcontainers.Container	// MailHog (SMTP testing)	LocalStackEndpoint  string	localstackContainer testcontainers.Container	// LocalStack (AWS)	ctx context.Context	t   *testing.Ttype UITestInfrastructure struct {// UITestInfrastructure holds all test containers and clients needed for UI E2E tests)	MockOIDCPort = "9090"	// MockOIDCPort is the port for mock OIDC provider	ThandServerPort = "8080"	// ThandServerPort is the default HTTP port for Thand server	TemporalDefaultPort = "7233"	// TemporalDefaultPort is the default gRPC port for Temporal server